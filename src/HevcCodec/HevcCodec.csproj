<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableComHosting>true</EnableComHosting>
    <PlatformTarget Condition="'$(CodecArchitecture)' == ''">x64</PlatformTarget>
    <PlatformTarget Condition="'$(CodecArchitecture)' != ''">$(CodecArchitecture)</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Universal Video Codec for Windows</Product>
    <AssemblyTitle>Universal Video Codec for Windows</AssemblyTitle>
    <Description>HEVC decoder for Windows Media Foundation</Description>
    <Company>Universal Video Codec for Windows</Company>
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
